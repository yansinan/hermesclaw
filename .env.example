# 推荐把 ilink_base_url / ilink_token 放到 agents.json；以下为可选 fallback（当 JSON 未提供时才使用）
ILINK_BASE_URL=https://ilinkai.weixin.qq.com
ILINK_TOKEN=replace-with-your-real-token
# manager.py msg 发送目标（可选；也可放到 agents.json: admin_ilink_uid）
# 推荐从 logs/router_state.json 顶层 key 获取（通常就是完整 from_user_id）。
# 先让管理员给机器人发一条消息，再读取该文件中的 key 并填入。
ADMIN_ILINK_UID=
HERMES_PROXY_PORT=19998
OPENCLAW_ENABLED=true
OPENCLAW_PROXY_PORT=19999
OPENCLAW_PROXY_HOST=0.0.0.0
HERMES_ENABLED=true
STATE_FILE=${HERMES_HOME:-/opt/data}/wechat-route/router_state.json
LOG_FILE=${HERMES_HOME:-/opt/data}/wechat-route/hermesclaw.log
LONG_POLL_TIMEOUT=35
# 统一入口反向代理端口（外部 Agent 连接用）
# Agent 的 base_url 需配为 http://host:PROXY_PORT/<agent_name>
PROXY_PORT=19990
# 配置优先级：脚本目录 ./agents.json -> AGENTS_CONFIG_FILE -> AGENTS_CONFIG -> legacy HERMES_/OPENCLAW_
# AGENTS_CONFIG_FILE 支持相对路径（相对于脚本目录）和绝对路径。
AGENTS_CONFIG_FILE=agents.json
# AGENTS_CONFIG 为内联 JSON（仅在未命中上面两个文件来源时使用），示例：
# AGENTS_CONFIG={"ilink_base_url":"https://ilinkai.weixin.qq.com","ilink_token":"replace-with-token","default_route":"hermes","agents":[{"name":"hermes","host":"127.0.0.1","port":19998,"enabled":true}]}